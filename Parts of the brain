                  <path d="M551 230 C568 234 576 250 566 265"/>
                </g>
                <!-- Glossy ice-white highlights on gyri -->
                <g fill="none" stroke="#ffffff" stroke-width="3.6" stroke-linecap="round" opacity="0.88">
