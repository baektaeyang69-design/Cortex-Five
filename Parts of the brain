    <!-- Region Information & Function Card -->
    <aside class="panel details" aria-live="polite">
      <div class="eyebrow">Selected brain region</div>

      <h2 id="partName">Choose a part</h2>
      <p id="intro">Tap any colored region on the brain diagram to inspect its anatomical location, definition, and primary functions.</p>

      <h3 id="definitionHeading" hidden>Definition</h3>
      <p id="definition" hidden></p>

      <h3 id="functionHeading" hidden>Main function</h3>
      <p id="function" hidden></p>

      <div class="note">
        <strong>Note:</strong> Although each lobe specializes in distinct sensory, motor, or cognitive tasks, the regions of the brain communicate continuously as one integrated network.
      </div>
    </aside>
  </main>

  <script>
    const parts = {
      frontal: {
        name: "Frontal Lobe",
        definition: "The frontal lobe is the largest and most anterior section of the cerebral cortex, located directly behind the forehead and separated from the parietal lobe by the central sulcus.",
        function: "It governs executive functions including planning, reasoning, decision-making, problem-solving, impulse control, voluntary motor movement (via the primary motor cortex), and speech production."
      },
      parietal: {
        name: "Parietal Lobe",
        definition: "The parietal lobe sits in the upper middle region of the cerebral hemisphere, positioned behind the frontal lobe and above the occipital and temporal lobes.",
        function: "It integrates somatosensory information such as touch, pressure, temperature, and pain, while supporting spatial awareness, navigation, and hand-eye coordination."
      },
      temporal: {
        name: "Temporal Lobe",
        definition: "The temporal lobe is situated on the lower sides of the brain beneath the lateral sulcus (Sylvian fissure), roughly aligned with the temples and ears.",
        function: "It processes auditory signals, enables language comprehension, recognizes faces and objects, and plays a vital role in forming and retrieving long-term memories."
      },
      occipital: {
        name: "Occipital Lobe",
        definition: "The occipital lobe is the rearmost region of the cerebrum, resting at the back of the skull just above the cerebellum.",
        function: "As the primary visual processing center of the brain, it interprets light signals from the eyes to perceive shapes, colors, depth, distance, and motion."
      },
      cerebellum: {
        name: "Cerebellum",
        definition: "The cerebellum (meaning 'little brain') is the densely folded, striped structure tucked beneath the occipital and temporal lobes at the lower back of the skull.",
        function: "It fine-tunes voluntary muscle activity to maintain posture, balance, equilibrium, and smooth, coordinated movements, as well as motor skill learning."
      },
      spinal: {
        name: "Spinal Cord",
        definition: "Extending downward from the brainstem at the base of the brain, the spinal cord is a cylindrical bundle of nerve fibers enclosed within the vertebral column.",
        function: "It acts as the main communication highway transmitting motor commands from the brain to the body, relaying sensory signals back to the brain, and coordinating rapid spinal reflexes."
      }
    };

    function selectBrainPart(key) {
      const data = parts[key];
      if (!data) return;

      // Update details panel
      document.getElementById("partName").textContent = data.name;
      document.getElementById("intro").hidden = true;

      ["definitionHeading", "definition", "functionHeading", "function"].forEach(id => {
        document.getElementById(id).hidden = false;
      });
      document.getElementById("definition").textContent = data.definition;
      document.getElementById("function").textContent = data.function;

      // Update SVG regions visual state
      document.querySelectorAll(".brain-region").forEach(region => {
        const isSelected = region.dataset.part === key;
        region.classList.toggle("active", isSelected);
        region.classList.toggle("dimmed", !isSelected);
      });

      // Highlight matching SVG text label
      document.querySelectorAll(".leader-label").forEach(lbl => {
        lbl.classList.toggle("active", lbl.dataset.label === key);
      });

      // Highlight matching button
      document.querySelectorAll("[data-button]").forEach(btn => {
        btn.classList.toggle("active", btn.dataset.button === key);
      });
    }

    // Attach interactions to SVG brain regions
    document.querySelectorAll(".brain-region").forEach(region => {
      region.addEventListener("click", () => selectBrainPart(region.dataset.part));
      region.addEventListener("keydown", e => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          selectBrainPart(region.dataset.part);
        }
      });
    });

    // Allow clicking text labels directly as well
    document.querySelectorAll(".leader-label").forEach(label => {
      label.addEventListener("click", () => selectBrainPart(label.dataset.label));
    });

    // Attach interactions to quick-select buttons
    document.querySelectorAll("[data-button]").forEach(btn => {
      btn.addEventListener("click", () => selectBrainPart(btn.dataset.button));
    });
  </script>
</body>
