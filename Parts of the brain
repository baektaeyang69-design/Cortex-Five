              <path class="lobe-outline" fill="url(#frontalGrad)" stroke="#5c060b" stroke-width="2.2" stroke-linejoin="round"
                d="M166 266 C152 246 151 224 162 206 C149 188 153 163 169 149 C166 125 182 99 207 90 C219 67 247 54 274 58 C293 43 324 41 346 53 C368 41 399 42 419 52 C416 69 401 81 393 97 C382 119 384 142 372 162 C360 183 361 206 347 224 C324 233 295 244 268 258 C240 272 213 287 188 282 C176 280 170 274 166 266 Z"/>
              <g clip-path="url(#clipFrontal)" pointer-events="none">
                <!-- Distinct Precentral Gyrus strip along the Central Sulcus (matches reference) -->
